# Copy to .env for local runs. In CI these come from GitHub Secrets/Vars —
# see docs/SECRETS.md for scope and how to create each one.

# --- Required ---
# Devin headless auth — either a key (credentials.toml is written by the engine)
# or the full credentials.toml contents.
DEVIN_API_KEY=
# DEVIN_CREDENTIALS_TOML=
# PAT (or GitHub App token) with contents:write on Collinskib/digitaltechadviser
SITE_REPO_TOKEN=

# --- Site repo ---
SITE_REPO=Collinskib/digitaltechadviser
SITE_BRANCH=master
SITE_BASE_URL=https://digitaltechadviser.com

# --- Devin CLI ---
DEVIN_BIN=devin
# DEVIN_MODEL=                 # empty = devin default
DEVIN_PERMISSION_MODE=dangerous
DEVIN_TIMEOUT_SEC=2400
# DEVIN_SANDBOX=false
# DEVIN_ALLOW_STORED_CREDS=    # local only: reuse ~/.local/share/devin/credentials.toml
# DEVIN_CREDS_PATH=            # local only: override credentials.toml location

# --- Pipeline ---
# ENGINE_MAX_ARTICLES=1        # 1–3
PUBLISH_MODE=publish           # publish | draft
# DRY_RUN=false                # everything except the push
# BUILD_VERIFY=true            # npm build in the site clone before publishing
# BUILD_FIX_ATTEMPTS=1         # devin fix cycles on build failure
# VERIFY_TIMEOUT_MIN=15        # live-URL poll after deploy
# ARTICLE_CATEGORY=ai          # AI skills vertical
# RUN_DATE=                    # YYYY-MM-DD override (tests)

# --- Optional integrations ---
# CLDSEO_SERVICE_ACCOUNT_JSON= # GSC + GA4 service-account JSON (sparse-data SEO)
# SLACK_WEBHOOK_URL=           # failure notifications
# NOTIFY_ISSUES=true           # open a GitHub issue on run failure

# --- Debugging (never in CI) ---
# KEEP_WORKDIR=false           # keep the temp workspace after the run
# DEBUG_VERBOSE=false          # log sanitized devin output tail
# WORKDIR_ROOT=                # temp root override (tests)
